@using GoodHamburger.Web.Services
@inject IToastService ToastService
@implements IDisposable
@rendermode InteractiveServer

<div class="toast-container">
    @foreach (var toast in _toasts)
    {
        <div class="toast-item toast-@toast.Type.ToString().ToLower() show" @key="toast.Id">
            <div class="toast-icon">
                @switch (toast.Type)
                {
                    case ToastType.Success:
                        <i class="bi bi-check-circle-fill"></i>
                        break;
                    case ToastType.Error:
                        <i class="bi bi-x-circle-fill"></i>
                        break;
                    case ToastType.Warning:
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        break;
                    case ToastType.Info:
                        <i class="bi bi-info-circle-fill"></i>
                        break;
                }
            </div>
            <div class="toast-body">
                <span class="toast-title">@toast.Type.ToString()</span>
                <span class="toast-message">@toast.Message</span>
            </div>
            <button class="toast-close" @onclick="() => Remove(toast.Id)">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }
</div>

@code {
    private List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += AddToast;
    }

    private void AddToast(ToastMessage toast)
    {
        _toasts.Add(toast);
        InvokeAsync(StateHasChanged);
        _ = RemoveAfterDelay(toast.Id);
    }

    private async Task RemoveAfterDelay(Guid id)
    {
        await Task.Delay(5000);
        Remove(id);
    }

    private void Remove(Guid id)
    {
        var toast = _toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            _toasts.Remove(toast);
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        ToastService.OnShow -= AddToast;
    }
}
