@page "/cart"
@using GoodHamburger.Web.Components.Models
@using GoodHamburger.Web.Services
@inject NavigationManager Navigation
@inject ICartService CartService
@inject IOrderService OrderService
@rendermode InteractiveServer

<div class="cart-page">
    <div class="cart-header">
        <h1>🛒 Seu Carrinho</h1>
        <a class="continue-shopping" href="/">Continuar comprando</a>
    </div>

    @if (_isLoading)
    {
        <div class="loading-overlay">
            <div class="spinner"></div>
            <p>Carregando...</p>
        </div>
    }
    else if (_orderDetails != null && _orderDetails.Itens.Any())
    {
        <!-- Carrinho com itens do pedido carregado da API -->
        <div class="cart-content">
            <div class="cart-items">
                @foreach (var item in _orderDetails.Itens)
                {
                    var qty = _itemQuantities.ContainsKey(item.ItemId) ? _itemQuantities[item.ItemId] : item.Quantidade;
                    <article class="cart-item">
                        <div class="cart-item-image">
                            <i class="bi bi-dish-fill"></i>
                        </div>
                        <div class="cart-item-details">
                            <h3>@item.ItemNome</h3>
                            <p>@item.Categoria</p>
                            <div class="quantity-control">
                                <button class="qty-btn" @onclick="() => DecreaseOrderItemQuantityAsync(item.ItemId)">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <span class="qty-value">@qty</span>
                                <button class="qty-btn" @onclick="() => IncreaseOrderItemQuantityAsync(item.ItemId)">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="cart-item-price">
                            <span class="price">@item.PrecoUnitario.ToString("C2")</span>
                            <button class="remove-btn" @onclick="() => RemoveOrderItemAsync(item.ItemId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </article>
                }
            </div>

            <aside class="cart-summary">
                <div class="summary-header">
                    <h2>Resumo do Pedido</h2>
                </div>
                <div class="summary-body">
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span><strong>@_orderDetails.Subtotal.ToString("C2")</strong></span>
                    </div>
                    @if (_orderDetails.Desconto > 0)
                    {
                        <div class="summary-row discount">
                            <span><i class="bi bi-tag"></i> Desconto</span>
                            <span>- @_orderDetails.Desconto.ToString("C2")</span>
                        </div>
                    }
                    <div class="summary-row">
                        <span>Taxa de Entrega</span>
                        <span><strong>@CartService.DeliveryFee.ToString("C2")</strong></span>
                    </div>
                    <div class="divider"></div>
                    <div class="total-row">
                        <span>Total</span>
                        <span class="total-amount">@_orderDetails.Total.ToString("C2")</span>
                    </div>
                    <div class="delivery-estimate">
                        <i class="bi bi-clock"></i> Entrega estimada: 25-35 min
                    </div>
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger mt-2">@_errorMessage</div>
                    }
                    <button class="checkout-btn" @onclick="ConfirmOrderAsync" disabled="@_isConfirming">
                        @if (_isConfirming)
                        {
                            <span><i class="bi bi-hourglass-split"></i> Processando...</span>
                        }
                        else
                        {
                            <span>Confirmar Pedido <i class="bi bi-check-circle"></i></span>
                        }
                    </button>
                    <p class="terms">Ao clicar em confirmar, você concorda com nossos Termos de Serviço.</p>
                </div>
            </aside>
        </div>
    }
    else if (CartService.Items.Any())
    {
        <!-- Carrinho local (sem pedido criado ainda) -->
        <div class="cart-content">
            <div class="cart-items">
                @foreach (var item in CartService.Items)
                {
                    <article class="cart-item">
                        <div class="cart-item-image">
                            @if (!string.IsNullOrEmpty(item.UrlImagem))
                            {
                                <img src="@item.UrlImagem" alt="@item.Nome" />
                            }
                            else
                            {
                                <i class="bi bi-@item.Icon"></i>
                            }
                        </div>
                        <div class="cart-item-details">
                            <h3>@item.Nome</h3>
                            <p>@item.Descricao</p>
                            <div class="quantity-control">
                                <button class="qty-btn" @onclick="() => DecreaseQuantityAsync(item.ItemId)">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <span class="qty-value">@item.Quantity</span>
                                <button class="qty-btn" @onclick="() => IncreaseQuantityAsync(item.ItemId)">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="cart-item-price">
                            <span class="price">@item.Preco.ToString("C2")</span>
                            <button class="remove-btn" @onclick="() => RemoveItemAsync(item.ItemId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </article>
                }
            </div>

            <aside class="cart-summary">
                <div class="summary-header">
                    <h2>Resumo do Pedido</h2>
                </div>
                <div class="summary-body">
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span><strong>@CartService.Subtotal.ToString("C2")</strong></span>
                    </div>
                    @if (CartService.Discount > 0)
                    {
                        <div class="summary-row discount">
                            <span><i class="bi bi-tag"></i> Desconto</span>
                            <span>- @CartService.Discount.ToString("C2")</span>
                        </div>
                    }
                    <div class="summary-row">
                        <span>Taxa de Entrega</span>
                        <span><strong>@CartService.DeliveryFee.ToString("C2")</strong></span>
                    </div>
                    <div class="divider"></div>
                    <div class="total-row">
                        <span>Total</span>
                        <span class="total-amount">@CartService.Total.ToString("C2")</span>
                    </div>
                    <div class="delivery-estimate">
                        <i class="bi bi-clock"></i> Entrega estimada: 25-35 min
                    </div>
                    <button class="checkout-btn" @onclick="FinalizarCompraAsync" disabled="@_isConfirming">
                        @if (_isConfirming)
                        {
                            <span><i class="bi bi-hourglass-split"></i> Processando...</span>
                        }
                        else
                        {
                            <span>Finalizar Compra <i class="bi bi-check-circle"></i></span>
                        }
                    </button>
                    <p class="terms">Ao clicar em confirmar, você concorda com nossos Termos de Serviço.</p>
                </div>
            </aside>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="empty-icon">
                <i class="bi bi-cart-x"></i>
            </div>
            <h2>Seu carrinho está vazio</h2>
            <p>Adicione alguns itens deliciosos ao seu carrinho!</p>
            <button class="shop-now-btn" @onclick="NavigateToHome">
                <i class="bi bi-burger"></i> Fazer Pedido
            </button>
        </div>
    }
</div>

@code {
    private PedidoDetalhes? _orderDetails;
    private Dictionary<Guid, int> _itemQuantities = new();
    private bool _isLoading = true;
    private bool _isConfirming = false;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await CartService.InitializeCartAsync();
        await LoadOrderFromApiAsync();
    }

    private async Task LoadOrderFromApiAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            if (CartService.HasOrder && CartService.OrderId.HasValue)
            {
                // Faz GET do pedido criado na Home
                _orderDetails = await OrderService.GetOrderByIdAsync(CartService.OrderId.Value);

                if (_orderDetails != null)
                {
                    _itemQuantities = _orderDetails.Itens.ToDictionary(i => i.ItemId, i => i.Quantidade);
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Erro ao carregar pedido: {ex.Message}");
            _errorMessage = "Erro ao carregar itens do pedido.";
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task IncreaseOrderItemQuantityAsync(Guid itemId)
    {
        if (!_itemQuantities.ContainsKey(itemId)) return;
        _itemQuantities[itemId]++;
        await SyncOrderItemsAsync();
    }

    private async Task DecreaseOrderItemQuantityAsync(Guid itemId)
    {
        if (!_itemQuantities.ContainsKey(itemId)) return;
        if (_itemQuantities[itemId] > 1)
        {
            _itemQuantities[itemId]--;
            await SyncOrderItemsAsync();
        }
    }

    private async Task RemoveOrderItemAsync(Guid itemId)
    {
        // 1. Remove do CartService local
        await CartService.RemoveItemAsync(itemId);
        _itemQuantities.Remove(itemId);

        // 2. Atualiza o pedido na API com os itens restantes
        if (CartService.OrderId == null) return;
        try
        {
            var itens = _itemQuantities.Select(kvp => new UpdateOrderItemDto
            {
                ItemId = kvp.Key,
                Quantidade = kvp.Value
            }).ToList();

            await OrderService.UpdateOrderAsync(CartService.OrderId.Value, itens, "Pendente");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Erro ao atualizar pedido após remoção: {ex.Message}");
            _errorMessage = "Erro ao atualizar pedido.";
            StateHasChanged();
            return;
        }

        // 3. Faz GET para carregar o pedido atualizado com totais recalculados
        await LoadOrderFromApiAsync();
    }

    private async Task SyncOrderItemsAsync()
    {
        if (CartService.OrderId == null) return;
        try
        {
            var itens = _itemQuantities.Select(kvp => new UpdateOrderItemDto
            {
                ItemId = kvp.Key,
                Quantidade = kvp.Value
            }).ToList();

            var updated = await OrderService.UpdateOrderAsync(CartService.OrderId.Value, itens, "Pendente");
            if (updated != null)
            {
                // Atualiza _orderDetails com os dados completos da API (subtotal, desconto, total recalculados)
                _orderDetails = updated;
                _itemQuantities = _orderDetails.Itens.ToDictionary(i => i.ItemId, i => i.Quantidade);

                // Sincroniza o CartService: remove itens que já não estão no pedido
                var updatedIds = _orderDetails.Itens.Select(i => i.ItemId).ToHashSet();
                foreach (var removedId in CartService.Items.Select(i => i.ItemId).Except(updatedIds).ToList())
                    await CartService.RemoveItemAsync(removedId);

                // Atualiza quantidades no CartService
                foreach (var item in _orderDetails.Itens)
                    await CartService.UpdateQuantityAsync(item.ItemId, item.Quantidade);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Erro ao sincronizar itens: {ex.Message}");
            _errorMessage = "Erro ao atualizar itens do pedido.";
        }
        StateHasChanged();
    }

    private async Task ConfirmOrderAsync()
    {
        if (CartService.OrderId == null) return;
        _isConfirming = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            var orderId = CartService.OrderId.Value;

            var itens = _itemQuantities.Select(kvp => new UpdateOrderItemDto
            {
                ItemId = kvp.Key,
                Quantidade = kvp.Value
            }).ToList();

            // Atualiza o pedido com os itens do carrinho e muda status para EmPreparacao (1)
            await OrderService.UpdateOrderAsync(orderId, itens, "EmPreparacao");

            await CartService.ClearCartAsync();
            await CartService.ClearOrderIdAsync();

            Navigation.NavigateTo($"/checkout/{orderId}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao confirmar pedido: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Erro ao confirmar pedido: {ex.Message}");
        }
        finally
        {
            _isConfirming = false;
            StateHasChanged();
        }
    }

    private async Task FinalizarCompraAsync()
    {
        // O pedido já foi criado em LoadOrderFromApiAsync, reutiliza o mesmo fluxo
        await ConfirmOrderAsync();
    }

    private async Task IncreaseQuantityAsync(Guid itemId)
    {
        var item = CartService.Items.FirstOrDefault(i => i.ItemId == itemId);
        if (item != null)
            await CartService.UpdateQuantityAsync(itemId, item.Quantity + 1);
    }

    private async Task DecreaseQuantityAsync(Guid itemId)
    {
        var item = CartService.Items.FirstOrDefault(i => i.ItemId == itemId);
        if (item != null && item.Quantity > 1)
            await CartService.UpdateQuantityAsync(itemId, item.Quantity - 1);
    }

    private async Task RemoveItemAsync(Guid itemId)
    {
        await CartService.RemoveItemAsync(itemId);
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
