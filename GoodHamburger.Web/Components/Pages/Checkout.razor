@page "/checkout"
@using GoodHamburger.Web.Components.Models
@inject NavigationManager NavigationManager

<PageTitle>Checkout - Burger HQ</PageTitle>

<div class="checkout-page">
    <!-- Header de Alerta -->
    @if (showDuplicateAlert)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Duplicate Item Detected: You already have a 'Double Cheese Melt' in your cart.</span>
            <button type="button" class="btn-close" @onclick="CloseAlert"></button>
        </div>
    }

    <div class="container-fluid py-4">
        <h1 class="mb-4">Resumo do Pedido</h1>

        <div class="row">
            <!-- Lista de Itens do Carrinho -->
            <div class="col-lg-7">
                <div class="cart-items">
                    @foreach (var item in cartItems)
                    {
                        <div class="cart-item-card">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <img src="@item.ImageUrl" alt="@item.Name" class="cart-item-image" />
                                    @if (item.IsComboDeal)
                                    {
                                        <span class="combo-badge">COMBO DEAL</span>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <h5 class="item-name">@item.Name</h5>
                                    <p class="item-description">@item.Description</p>
                                </div>
                                <div class="col-md-3 text-md-end">
                                    <span class="item-price">$@item.Price.ToString("F2")</span>
                                </div>
                                <div class="col-12">
                                    <div class="quantity-control d-flex align-items-center justify-content-between justify-content-md-center gap-3">
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => DecreaseQuantity(item)">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <span class="quantity-value">@item.Quantity</span>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => IncreaseQuantity(item)">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                        <a href="#" class="remove-link" @onclick="() => RemoveItem(item)">
                                            <i class="bi bi-trash"></i> Remove
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Botão para continuar comprando -->
                    <div class="continue-shopping mt-4">
                        <button class="btn btn-outline-primary w-100">
                            <i class="bi bi-plus-circle"></i> Browse more delicious options
                        </button>
                    </div>
                </div>
            </div>

            <!-- Resumo do Pedido -->
            <div class="col-lg-5">
                <div class="order-summary">
                    <h5 class="mb-4">Resumo</h5>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>$@subtotal.ToString("F2")</span>
                    </div>

                    @if (hasComboDiscount)
                    {
                        <div class="summary-row discount">
                            <span><i class="bi bi-tag"></i> Combo Discount (20%)</span>
                            <span>-$@comboDiscount.ToString("F2")</span>
                        </div>
                    }

                    <div class="summary-row">
                        <span>Delivery Fee</span>
                        <span>$@deliveryFee.ToString("F2")</span>
                    </div>

                    <div class="summary-total">
                        <span>Total</span>
                        <div>
                            <span class="total-price">$@total.ToString("F2")</span>
                            <span class="estimated-delivery">Estimated delivery: 25-35 min</span>
                        </div>
                    </div>

                    <button class="btn btn-confirm-order w-100 mt-4">
                        Confirm Order <i class="bi bi-arrow-right"></i>
                    </button>

                    <p class="terms-text mt-3 text-center">
                        By clicking confirm, you agree to our Terms of Service.
                    </p>

                    <!-- Método de Pagamento -->
                    <div class="payment-method mt-4">
                        <h6 class="text-uppercase text-muted mb-3">Payment Method</h6>
                        <div class="payment-card">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-credit-card"></i>
                                <span class="ms-2">Visa ending in 4421</span>
                            </div>
                            <a href="#" class="change-link">Change</a>
                        </div>
                    </div>

                    <!-- Programa de Fidelidade -->
                    <div class="loyalty-banner mt-4">
                        <div class="loyalty-content">
                            <i class="bi bi-star-fill"></i>
                            <div class="loyalty-text">
                                <strong>Join Burger Rewards</strong>
                                <span>Earn 50 points with this order!</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool showDuplicateAlert = true;
    private decimal subtotal = 59.00m;
    private decimal comboDiscount = 11.80m;
    private decimal deliveryFee = 3.50m;
    private decimal total = 50.70m;
    private bool hasComboDiscount = true;

    private List<CartItem> cartItems = new()
    {
        new CartItem
        {
            Id = 1,
            Name = "Double Cheese Melt",
            Description = "2x Wagyu Beef, Triple Cheddar, Caramelized Onions",
            Price = 18.50m,
            Quantity = 2,
            ImageUrl = "/images/double-cheese-melt.jpg",
            IsComboDeal = false
        },
        new CartItem
        {
            Id = 2,
            Name = "Bacon BBQ Combo",
            Description = "Includes Large Fries & Craft Soda",
            Price = 22.00m,
            Quantity = 1,
            ImageUrl = "/images/bacon-bbq-combo.jpg",
            IsComboDeal = true
        }
    };

    private void CloseAlert()
    {
        showDuplicateAlert = false;
    }

    private void IncreaseQuantity(CartItem item)
    {
        item.Quantity++;
        RecalculateTotals();
    }

    private void DecreaseQuantity(CartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
            RecalculateTotals();
        }
    }

    private void RemoveItem(CartItem item)
    {
        cartItems.Remove(item);
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        subtotal = cartItems.Sum(i => i.Price * i.Quantity);
        hasComboDiscount = cartItems.Any(i => i.IsComboDeal);
        comboDiscount = hasComboDiscount ? subtotal * 0.20m : 0;
        total = subtotal - comboDiscount + deliveryFee;
    }
}
