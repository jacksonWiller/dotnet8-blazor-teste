@page "/checkout"
@page "/checkout/{OrderId:guid}"
@using GoodHamburger.Web.Components.Models
@using GoodHamburger.Web.Services
@inject NavigationManager Navigation
@inject ICartService CartService
@inject IOrderService OrderService
@rendermode InteractiveServer

<PageTitle>Checkout - Good Hamburger</PageTitle>

<div class="checkout-page">
    @if (loading)
    {
        <div class="loading-overlay">
            <div class="spinner"></div>
            <p>Carregando...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@errorMessage</span>
            <button @onclick="NavigateToCart" class="btn btn-sm btn-light mt-2">Voltar ao Carrinho</button>
        </div>
    }
    else if (orderCreated)
    {
        <div class="order-success">
            <i class="bi bi-check-circle-fill"></i>
            <h2>Pedido Criado com Sucesso!</h2>
            <p>Obrigado pela sua compra!</p>
            <div class="order-details">
                <p><strong>ID do Pedido:</strong> @orderResponse?.PedidoId.ToString().ToUpper()</p>
                <p><strong>Total:</strong> @orderResponse?.Total.ToString("C2")</p>
            </div>
            <button @onclick="NavigateToHome" class="btn btn-primary">
                <i class="bi bi-house-fill"></i> Fazer Novo Pedido
            </button>
        </div>
    }   
    else if (CartService.Items.Any() == false)
    {
        // Se houver OrderId, mostrar detalhes do pedido
        if (OrderId != Guid.Empty && orderDetails != null)
        {
            <div class="order-details-page">
                <h1 class="mb-4">Detalhes do Pedido</h1>
                
                <div class="order-info-card">
                    <div class="order-header">
                        <h3><i class="bi bi-receipt"></i> Informações do Pedido</h3>
                        <span class="order-id">ID: @orderDetails.Id.ToString().ToUpper()</span>
                    </div>
                    
                    <div class="order-status">
                        <span class="status-badge">Status: @orderDetails.Status</span>
                    </div>
                    
                    <div class="order-meta">
                        <p><i class="bi bi-calendar3"></i> Data de Criação: @orderDetails.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
                
                <div class="order-items-list">
                    <h4 class="mb-3">Itens do Pedido</h4>
                    @foreach (var item in orderDetails.Itens)
                    {
                        <div class="order-item-card">
                            <div class="item-info">
                                <span class="item-name">@item.ItemNome</span>
                                <span class="item-quantity">x @item.Quantidade</span>
                            </div>
                            <span class="item-total">@item.Subtotal.ToString("C2")</span>
                        </div>
                    }
                </div>
                
                <div class="order-total-card">
                    <div class="total-row">
                        <span>Subtotal:</span>
                        <span>@orderDetails.Subtotal.ToString("C2")</span>
                    </div>
                    <div class="total-row">
                        <span>Desconto:</span>
                        <span>@orderDetails.Desconto.ToString("C2")</span>
                    </div>
                    <div class="total-row final">
                        <span>Total:</span>
                        <span>@orderDetails.Total.ToString("C2")</span>
                    </div>
                </div>
                
                <div class="order-actions">
                    <button class="btn btn-primary" @onclick="NavigateToHome">
                        <i class="bi bi-house-fill"></i> Fazer Novo Pedido
                    </button>
                    @if (orderDetails.Status != "Cancelado")
                    {
                        <button class="btn btn-danger ms-2" @onclick="CancelOrderAsync" disabled="@isCancelling">
                            @if (isCancelling)
                            {
                                <span><i class="bi bi-hourglass-split"></i> Cancelando...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-x-circle"></i> Cancelar Pedido</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-cart">
                <i class="bi bi-cart-x"></i>
                <h2>Seu carrinho está vazio</h2>
                <p>Adicione itens antes de finalizar o pedido.</p>
                <button @onclick="NavigateToCart" class="btn btn-primary">
                    <i class="bi bi-cart"></i> Ir para o Carrinho
                </button>
            </div>
        }
    }
    else
    {
        <div class="container-fluid py-4">
            <h1 class="mb-4">Finalizar Pedido</h1>

            <div class="row">
                <!-- Lista de Itens do Carrinho -->
                <div class="col-lg-7">
                    <div class="cart-items">
                        @foreach (var item in CartService.Items)
                        {
                            <div class="cart-item-card">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        @if (!string.IsNullOrEmpty(item.UrlImagem))
                                        {
                                            <img src="@item.UrlImagem" alt="@item.Nome" class="cart-item-image" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-@item.Icon"></i>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <h5 class="item-name">@item.Nome</h5>
                                        <p class="item-description">@item.Descricao</p>
                                        <small class="text-muted">@item.Categoria</small>
                                    </div>
                                    <div class="col-md-3 text-md-end">
                                        <span class="item-price">@item.Preco.ToString("C2")</span>
                                    </div>
                                    <div class="col-12">
                                        <div class="quantity-control d-flex align-items-center justify-content-between justify-content-md-center gap-3">
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => DecreaseQuantityAsync(item.ItemId)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <span class="quantity-value">@item.Quantity</span>
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => IncreaseQuantityAsync(item.ItemId)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                            <a href="#" class="remove-link" @onclick="() => RemoveItemAsync(item.ItemId)">
                                                <i class="bi bi-trash"></i> Remover
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Botão para continuar comprando -->
                        <div class="continue-shopping mt-4">
                            <button class="btn btn-outline-primary w-100" @onclick="NavigateToCart">
                                <i class="bi bi-plus-circle"></i> Continuar Comprando
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Resumo do Pedido -->
                <div class="col-lg-5">
                    <div class="order-summary">
                        <h5 class="mb-4">Resumo</h5>

                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>@CartService.Subtotal.ToString("C2")</span>
                        </div>

                        @if (CartService.Discount > 0)
                        {
                            <div class="summary-row discount">
                                <span><i class="bi bi-tag"></i> Desconto</span>
                                <span>- @CartService.Discount.ToString("C2")</span>
                            </div>
                        }

                        <div class="summary-row">
                            <span>Taxa de Entrega</span>
                            <span>@CartService.DeliveryFee.ToString("C2")</span>
                        </div>

                        <div class="summary-total">
                            <span>Total</span>
                            <div>
                                <span class="total-price">@CartService.Total.ToString("C2")</span>
                                <span class="estimated-delivery">Entrega estimada: 25-35 min</span>
                            </div>
                        </div>

                        <button class="btn btn-confirm-order w-100 mt-4" @onclick="PlaceOrderAsync" disabled="@placingOrder">
                            @if (placingOrder)
                            {
                                <span><i class="bi bi-hourglass-split"></i> Processando...</span>
                            }
                            else
                            {
                                <span>Confirmar Pedido <i class="bi bi-arrow-right"></i></span>
                            }
                        </button>

                        <p class="terms-text mt-3 text-center">
                            Ao clicar em confirmar, você concorda com nossos Termos de Serviço.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private bool loading = true;
    private bool orderCreated = false;
    private bool placingOrder = false;
    private bool isCancelling = false;
    private string? errorMessage;
    private CreatePedidoResponse? orderResponse;
    private PedidoDetalhes? orderDetails;

    protected override async Task OnInitializedAsync()
    {
        //await CartService.InitializeCartAsync();
        
        // Se houver OrderId na URL, buscar os detalhes do pedido
        if (OrderId != Guid.Empty)
        {
            await LoadOrderDetailsAsync(OrderId);
        }
        else
        {
            loading = false;
        }
    }

    private async Task LoadOrderDetailsAsync(Guid orderId)
    {
        try
        {
            // Buscar os detalhes do pedido pelo ID
            orderDetails = await OrderService.GetOrderByIdAsync(orderId);
            loading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar pedido: {ex.Message}";
            loading = false;
        }
    }

    private async Task IncreaseQuantityAsync(Guid itemId)
    {
        var item = CartService.Items.FirstOrDefault(i => i.ItemId == itemId);
        if (item != null)
        {
            await CartService.UpdateQuantityAsync(itemId, item.Quantity + 1);
        }
    }

    private async Task DecreaseQuantityAsync(Guid itemId)
    {
        var item = CartService.Items.FirstOrDefault(i => i.ItemId == itemId);
        if (item != null && item.Quantity > 1)
        {
            await CartService.UpdateQuantityAsync(itemId, item.Quantity - 1);
        }
    }

    private async Task RemoveItemAsync(Guid itemId)
    {
        await CartService.RemoveItemAsync(itemId);
    }

    private async Task PlaceOrderAsync()
    {
        try
        {
            placingOrder = true;
            errorMessage = null;

            // Obter IDs dos itens do carrinho
            var itemIds = CartService.Items.Select(i => i.ItemId).ToList();

            // Criar pedido via API
            orderResponse = await OrderService.CreateOrderAsync(itemIds);
            orderCreated = true;

            // Limpar carrinho após pedido criado
            await CartService.ClearCartAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao criar pedido: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Error: {ex}");
        }
        finally
        {
            placingOrder = false;
        }
    }

    private async Task CancelOrderAsync()
    {
        if (orderDetails == null) return;
        isCancelling = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            await OrderService.UpdateOrderAsync(orderDetails.Id, orderDetails.Itens.Select(i => new UpdateOrderItemDto
            {
                ItemId = i.ItemId,
                Quantidade = i.Quantidade
            }).ToList(), "Cancelado");

            await CartService.ClearCartAsync();
            await CartService.ClearOrderIdAsync();

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao cancelar pedido: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Erro ao cancelar pedido: {ex.Message}");
        }
        finally
        {
            isCancelling = false;
            StateHasChanged();
        }
    }

    private void NavigateToCart()
    {
        Navigation.NavigateTo("/cart");
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }
}
