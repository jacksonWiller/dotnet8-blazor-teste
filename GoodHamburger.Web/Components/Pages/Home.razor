@page "/"
@using GoodHamburger.Web.Components.Models
@using GoodHamburger.Web.Services
@inject NavigationManager Navigation
@inject IItemService ItemService
@inject ICartService CartService
@rendermode InteractiveServer

@code {
    private List<ItemDto> items = new();
    private bool loading = true;
    private string? errorMessage;
    private string? notificationMessage;
    private bool showNotification = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        try
        {
            items = await ItemService.GetAllItemsAsync();
            Console.WriteLine($"========================================");
            Console.WriteLine($"Total de itens carregados: {items.Count}");
            Console.WriteLine($"========================================");
            
            for (int i = 0; i < items.Count; i++)
            {
                var item = items[i];
                Console.WriteLine($"Item {i + 1}:");
                Console.WriteLine($"  ID: {item.Id}");
                Console.WriteLine($"  Nome: {item.Nome}");
                Console.WriteLine($"  Descrição: {item.Descricao}");
                Console.WriteLine($"  Preço: {item.Preco}");
                Console.WriteLine($"  Tipo: {item.Tipo}");
                Console.WriteLine($"  Categoria: {item.Categoria}");
                Console.WriteLine($"  URL Imagem: {item.UrlImagem}");
                Console.WriteLine($"  Removido: {item.Removido}");
                Console.WriteLine($"----------------------------------------");
            }
            
            loading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"========================================");
            Console.WriteLine($"ERRO ao carregar produtos:");
            Console.WriteLine($"  Mensagem: {ex.Message}");
            Console.WriteLine($"  Stack: {ex.StackTrace}");
            Console.WriteLine($"========================================");
            errorMessage = "Erro ao carregar produtos: " + ex.Message;
            loading = false;
        }
    }
}

<section class="hero">
    <div class="hero-card">
        <div class="hero-content">
            <span class="badge">Daily Special</span>
            <h1>The Truffle<br>Masterpiece</h1>
            <p>Wagyu beef, black truffle aioli, aged swiss, and sautéed wild mushrooms on a toasted brioche bun.</p>
        </div>
        <div class="hero-footer">
            <span class="price-lg">$18.50</span>
            <button class="btn-light">Order Now</button>
        </div>
    </div>

    <div class="deal-card">
        <h2>Spicy Weekend Deal</h2>
        <p>Get 2 Fire-Grilled Jalapeño Burgers for the price of 1. Limited time only!</p>
        <div class="save">SAVE 50%</div>
        <button class="btn-light">CLAIM DEAL</button>
    </div>
</section>

<div class="filter-row">
    <div class="categories">
        <div class="category active">
            <span class="cat-icon"><i class="bi bi-burger"></i></span>
            Sandwiches
        </div>
        <div class="category">
            <span class="cat-icon"><i class="bi bi-plate-fill"></i></span>
            Sides
        </div>
        <div class="category">
            <span class="cat-icon"><i class="bi bi-cup-hot-fill"></i></span>
            Drinks
        </div>
        <div class="category">
            <span class="cat-icon"><i class="bi bi-ice-cream"></i></span>
            Desserts
        </div>
    </div>
    <a class="filters-link" href="#">
        <span class="filter-icon"><i class="bi bi-list"></i></span>
        Filters
    </a>
</div>

<section class="products">
    
    @if (loading)
    {
        <div class="loading">
            <p>Carregando produtos...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error">
            <p>@errorMessage</p>
        </div>
    }
    else
    {
        @if (items.Count == 0)
        {
            <div class="no-items">
                <p style="background: orange; padding: 20px; color: white;">
                    Nenhum item encontrado! A lista está vazia.
                </p>
            </div>
        }
        
        @foreach (var item in items)
        {
            <article class="card">
                <div class="card-image">
                    @if (!string.IsNullOrEmpty(item.UrlImagem))
                    {
                        <img src="@item.UrlImagem" alt="@item.Nome" />
                    }
                    else
                    {
                        <i class="bi bi-@GetIconForType(item.Tipo)"></i>
                    }
                    <div class="fav">
                        <i class="bi bi-heart"></i>
                    </div>
                </div>
                <div class="card-body">
                    <h3>@item.Nome</h3>
                    <p>@item.Descricao</p>
                    <div class="card-footer">
                        <span class="price">@FormatPrice(item.Preco)</span>
                        <button class="add-btn" @onclick="() => AddToCartAsync(item)">
                            <i class="bi bi-cart-plus"></i> Add
                        </button>
                    </div>
                </div>
            </article>
        }
    }
</section>

@if (showNotification)
{
    <div class="notification">
        <i class="bi bi-check-circle-fill"></i>
        <span>@notificationMessage</span>
        <button @onclick="HideNotification" class="close-btn">&times;</button>
    </div>
}

<a class="floating-btn" href="#menu">🍴</a>

@code {
    private async Task AddToCartAsync(ItemDto item)
    {
        try
        {
            await CartService.AddItemAsync(item);
            notificationMessage = $"{item.Nome} adicionado ao carrinho!";
            showNotification = true;
        }
        catch (InvalidOperationException ex)
        {
            notificationMessage = ex.Message;
            showNotification = true;
        }
        catch (Exception ex)
        {
            notificationMessage = $"Erro ao adicionar item: {ex.Message}";
            showNotification = true;
        }
    }

    private void HideNotification()
    {
        showNotification = false;
    }

    private string GetIconForType(string tipo)
    {
        return tipo.ToLower() switch
        {
            "sanduiche" or "burger" or "hamburguer" => "burger",
            "acompanhamento" or "side" or "fritura" => "dish-fill",
            "bebida" or "drink" or "refrigerante" => "cup-hot-fill",
            "sobremesa" or "dessert" => "ice-cream",
            _ => "emoji-smile"
        };
    }

    private string FormatPrice(decimal preco)
    {
        return preco.ToString("C2").Replace("R$", "R$");
    }
}

<a class="floating-btn" href="#menu">🍴</a>
