@page "/orders/{OrderId:guid}"
@page "/order-detail/{OrderId:guid}"
@page "/order/{OrderId:guid}"
@using GoodHamburger.Web.Components.Models
@using GoodHamburger.Web.Services
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IOrderService OrderService
@rendermode InteractiveServer

@if (loading)
{
    <div class="order-detail-page">
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Carregando detalhes do pedido...</p>
        </div>
    </div>
}
else if (order is null)
{
    <div class="order-detail-page">
        <div class="order-detail-header">
            <div class="order-detail-title">
                <h1>Pedido não encontrado</h1>
                <p class="order-detail-subtitle">ID: #@OrderId</p>
            </div>
            <div class="order-detail-actions">
                <button class="btn-filter" type="button" @onclick='() => Navigation.NavigateTo("/orders")'>
                    <i class="bi bi-arrow-left"></i> Voltar
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="order-detail-page">
        <div class="order-detail-header">
            <div class="order-detail-title">
                <h1>Pedido #@order.Id</h1>
                <p class="order-detail-subtitle">Criado em @order.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <div class="order-detail-actions">
                <button class="btn-filter" type="button" @onclick="EditOrder">
                    <i class="bi bi-pencil"></i> Editar
                </button>
                <button class="btn-filter btn-filter-danger" type="button" @onclick="CancelOrderAsync">
                    <i class="bi bi-x-circle"></i> Remover
                </button>
            </div>
        </div>

        <div class="order-detail-timeline">
            <div class="order-detail-step done">
                <div class="order-detail-step-dot"></div>
                <div class="order-detail-step-text">Confirmado</div>
            </div>
            <div class="order-detail-step done">
                <div class="order-detail-step-dot"></div>
                <div class="order-detail-step-text">Preparando</div>
            </div>
            <div class="order-detail-step active">
                <div class="order-detail-step-dot"></div>
                <div class="order-detail-step-text">Pronto para entrega</div>
            </div>
        </div>

        <div class="order-detail-grid">
            <section class="order-detail-items">
                <h2 class="order-detail-section-title">Itens</h2>
                @foreach (var item in order.Itens)
                {
                    <article class="order-detail-item">
                        <div class="order-detail-item-info">
                            <div class="order-detail-item-name">@item.ItemNome</div>
                            <div class="order-detail-item-desc">@item.Categoria</div>
                            <div class="order-detail-item-meta">Qtd: @item.Quantidade</div>
                        </div>
                        <div class="order-detail-item-price">@item.PrecoUnitario.ToString("C2")</div>
                    </article>
                }
            </section>

            <aside class="order-detail-summary">
                <h2 class="order-detail-section-title">Resumo</h2>
                <div class="order-detail-summary-row">
                    <span>Subtotal</span>
                    <span><strong>@order.Subtotal.ToString("C2")</strong></span>
                </div>
                @if (order.Desconto > 0)
                {
                    <div class="order-detail-summary-row discount">
                        <span><i class="bi bi-tag"></i> Desconto</span>
                        <span>- @order.Desconto.ToString("C2")</span>
                    </div>
                }
                <div class="divider"></div>
                <div class="order-detail-total">
                    <span>Total</span>
                    <span class="order-detail-total-amount">@order.Total.ToString("C2")</span>
                </div>

                <div class="order-detail-summary-actions">
                    <button class="add-btn" type="button" @onclick="TrackOrder">
                        <i class="bi bi-truck"></i> Rastrear
                    </button>
                    <button class="btn-filter" type="button" @onclick="DownloadReceipt">
                        <i class="bi bi-download"></i> Recibo
                    </button>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    private PedidoDetalhes? order;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        StateHasChanged();
        
        try
        {
            order = await OrderService.GetOrderByIdAsync(OrderId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar pedido: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void EditOrder()
    {
        Navigation.NavigateTo("/orders");
    }

    private async Task CancelOrderAsync()
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Tem certeza que deseja cancelar o pedido #{OrderId}?");
        if (confirmed)
        {
            Navigation.NavigateTo("/orders");
        }
    }

    private void TrackOrder()
    {
        Navigation.NavigateTo("/orders");
    }

    private void DownloadReceipt()
    {
        // Implement via JS interop / API when available
    }
}
