@page "/orders"
@using GoodHamburger.Web.Components.Models
@inject NavigationManager Navigation
@rendermode InteractiveServer

<section class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon pending">
            <i class="bi bi-clock"></i>
        </div>
        <div class="stat-info">
            <h3>@pendingOrders.Count</h3>
            <p>Pending</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon cooking">
            <i class="bi bi-fire"></i>
        </div>
        <div class="stat-info">
            <h3>@cookingOrders.Count</h3>
            <p>In Cooking</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon ready">
            <i class="bi bi-check-circle"></i>
        </div>
        <div class="stat-info">
            <h3>@readyOrders.Count</h3>
            <p>Ready</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon completed">
            <i class="bi bi-check-lg"></i>
        </div>
        <div class="stat-info">
            <h3>@completedOrders.Count</h3>
            <p>Completed</p>
        </div>
    </div>
</section>

<div class="orders-filter-row">
    <div class="status-filters">
        <div class="status-filter active" data-status="all">
            <i class="bi bi-grid"></i> All Orders
        </div>
        <div class="status-filter" data-status="pending">
            <i class="bi bi-clock"></i> Pending
        </div>
        <div class="status-filter" data-status="cooking">
            <i class="bi bi-fire"></i> Cooking
        </div>
        <div class="status-filter" data-status="ready">
            <i class="bi bi-check-circle"></i> Ready
        </div>
        <div class="status-filter" data-status="completed">
            <i class="bi bi-check-lg"></i> Completed
        </div>
    </div>
    <div class="filter-actions">
        <button class="btn-filter">
            <i class="bi bi-funnel"></i> Filter
        </button>
        <button class="btn-filter">
            <i class="bi bi-download"></i> Export
        </button>
    </div>
</div>

<section class="orders-table">
    <table class="table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Time</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in filteredOrders)
            {
                <tr data-status="@order.Status">
                    <td>
                        <span class="order-id">#@order.OrderId</span>
                    </td>
                    <td>
                        <div class="customer-info">
                            <div class="customer-avatar">@order.CustomerInitials</div>
                            <div class="customer-name">@order.CustomerName</div>
                        </div>
                    </td>
                    <td>
                        <div class="order-items">
                            @for (int i = 0; i < order.Items.Count; i++)
                            {
                                if (i < 3)
                                {
                                    <span class="item-badge">@order.Items[i]</span>
                                }
                                else if (i == 3)
                                {
                                    <span class="item-more">+@((order.Items.Count - 3)) more</span>
                                }
                            }
                        </div>
                    </td>
                    <td>
                        <span class="order-total">@order.Total</span>
                    </td>
                    <td>
                        <span class="status-badge status-@order.Status">@order.Status</span>
                    </td>
                    <td>
                        <span class="order-time">@order.Time</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn-action" type="button" title="View" @onclick='() => Navigation.NavigateTo($"/orders/{order.OrderId}")'>
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn-action" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn-action" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<a class="floating-btn" href="#orders">📋</a>

