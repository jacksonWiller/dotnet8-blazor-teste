@page "/orders"
@using GoodHamburger.Web.Components.Models
@using GoodHamburger.Web.Services
@using System.Linq
@inject NavigationManager Navigation
@inject IOrderService OrderService
@rendermode InteractiveServer

@if (loading)
{
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>Carregando pedidos...</p>
    </div>
}
else
{
    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="bi bi-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@pedidos.Count</h3>
                <p>Total de Pedidos</p>
            </div>
        </div>
    </section>

    <section class="orders-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Pedido ID</th>
                    <th>Itens</th>
                    <th>Total</th>
                    <th>Data de Criação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (pedidos.Any())
                {
                    @foreach (var pedido in pedidos)
                    {
                        <tr>
                            <td>
                                <span class="order-id">#@pedido.Id.ToString().Substring(0, 8)</span>
                            </td>
                            <td>
                                <div class="order-items">
                                    @for (int i = 0; i < pedido.Itens.Count; i++)
                                    {
                                        if (i < 3)
                                        {
                                            <span class="item-badge">@pedido.Itens[i].ItemNome (@pedido.Itens[i].Quantidade)x</span>
                                        }
                                        else if (i == 3)
                                        {
                                            <span class="item-more">+@((pedido.Itens.Count - 3)) mais</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="order-total">@FormatCurrency(pedido.Total)</span>
                            </td>
                            <td>
                                <span class="order-time">@FormatDate(pedido.DataCriacao)</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-action" type="button" title="Ver" @onclick='() => Navigation.NavigateTo($"/orders/{pedido.Id}")'>
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 20px;">
                            <p>Nenhum pedido encontrado.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private List<PedidoDetalhes> pedidos = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPedidosAsync();
    }

    private async Task LoadPedidosAsync()
    {
        try
        {
            loading = true;
            var response = await OrderService.GetAllOrdersAsync(1, 100);
            pedidos = response.Pedidos;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar pedidos: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private string FormatCurrency(decimal value)
    {
        return value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    }
}
